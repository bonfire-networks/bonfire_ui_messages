<div class="flex-1 w-full">
  {#if @composing_new}
    {!-- Contact picker replaces thread list --}
    <Bonfire.UI.Messages.ContactPickerLive
      id="contact_picker"
      selected_recipients={@selected_recipients}
    />
  {#else}
    <div class="">
      <div class="group/message-search grid grid-cols-[minmax(3rem,1fr)_minmax(0,1fr)] items-center px-3 gap-2 py-2 transition-[grid-template-columns] duration-200 ease-in-out motion-reduce:transition-none has-[input:focus]:grid-cols-[minmax(3rem,0fr)_minmax(0,6fr)]">
        <button
          phx-click="Bonfire.Messages:toggle_contact_picker"
          class="btn btn-primary w-full min-w-0 overflow-hidden"
          aria-label={l("New message")}
        >
          <#Icon iconify="tabler:mail-plus" class="size-5 shrink-0" />
          <span class="max-w-40 overflow-hidden whitespace-nowrap transition-[max-width,opacity] duration-200 ease-in-out motion-reduce:transition-none group-has-[input:focus]/message-search:max-w-0 group-has-[input:focus]/message-search:opacity-0">
            {l("New Message")}
          </span>
        </button>
        <form class="w-full min-w-0" phx-change="Bonfire.Messages:search_threads">
          <label class="border-hair border-divider input w-full">
            <#Icon iconify="ph:magnifying-glass-duotone" class="size-5 text-muted" />
            <span class="sr-only">{l("Search messages")}</span>
            <input
              type="search"
              name="search"
              placeholder={l("Search messages...")}
              value={@search_term}
              phx-debounce="100"
              class="grow"
            />
            <button
              :if={@search_term}
              type="button"
              phx-click="Bonfire.Messages:search_threads"
              phx-value-search=""
              class="btn btn-ghost btn-circle btn-sm text-subtle hover:text-base-content"
            >
              <#Icon iconify="ph:x-duotone" class="size-4" />
            </button>
          </label>
        </form>
      </div>
      {!-- Message Tabs --}
      {!-- Inbox, and Hidden for what the "Hide notifications and messages from" switches keep out, offered only to someone who hides something. They replace the relationship tabs (All / Followed only / Other) --}
      <div class="bg-base-200 border-y-hair border-divider py-1 px-3 flex items-center gap-3">
        <div role="tablist" class="flex gap-3 flex-1">
          {!-- id and role through `opts`, since a plain link renders only those --}
          <LinkLive
            to="/messages"
            opts={
              id: "messages-tab-inbox",
              role: "tab",
              "aria-current": if(@filter_tab != "hidden", do: "page")
            }
            class={[
              "btn btn-sm rounded-full",
              "!font-medium": @filter_tab != "hidden",
              "text-muted": @filter_tab == "hidden"
            ]}
          >{l("Inbox")}</LinkLive>
          <LinkLive
            :if={hides_any?(@__context__)}
            to="/messages?tab=hidden"
            opts={
              id: "messages-tab-hidden",
              role: "tab",
              "aria-current": if(@filter_tab == "hidden", do: "page")
            }
            class={[
              "btn btn-sm rounded-full",
              "!font-medium": @filter_tab == "hidden",
              "text-muted": @filter_tab != "hidden"
            ]}
          >{l("Hidden")}</LinkLive>
        </div>
        {!-- the same switches as in notification preferences and Privacy & Safety, opened here rather than linked to --}
        <button
          id="messages-audiences-toggle"
          type="button"
          class="btn btn-ghost btn-circle btn-sm"
          aria-expanded="false"
          aria-controls="messages-audiences-panel"
          phx-click={JS.toggle(to: "#messages-audiences-panel")
          |> JS.toggle_attribute({"aria-expanded", "true", "false"}, to: "#messages-audiences-toggle")}
        >
          <#Icon iconify="ph:sliders-horizontal" class="size-5" />
          <span class="sr-only">{l("Message preferences")}</span>
        </button>
      </div>
      <section
        id="messages-audiences-panel"
        aria-label={l("Message preferences")}
        style="display: none;"
        class="p-4 border-b-hair border-divider"
      >
        <StatelessComponent module={maybe_component(Bonfire.UI.Social.HiddenAudiencesLive, @__context__)} />
      </section>
      {!-- <div role="tablist" class="bg-base-200  border-y-hair border-divider gap-3 py-1 px-3 flex">
        <LinkLive
          to="/messages?tab=all"
          role="tab"
          class={[
            "btn btn-sm rounded-full",
            "!font-medium": (@filter_tab || "all") == "all",
            "text-muted": (@filter_tab || "all") != "all"
          ]}
        >{l("All")}</LinkLive>
        <LinkLive
          to="/messages?tab=followed_only"
          role="tab"
          class={[
            "btn btn-sm rounded-full",
            "!font-medium": @filter_tab == "followed_only",
            "text-muted": @filter_tab != "followed_only"
          ]}
        >{l("Followed only")}</LinkLive>
        <LinkLive
          to="/messages?tab=not_followed"
          role="tab"
          class={[
            "btn btn-sm rounded-full",
            "!font-medium": @filter_tab == "not_followed",
            "text-muted": @filter_tab != "not_followed"
          ]}
        >{l("Other")}</LinkLive>
      </div> --}
    </div>
    {#if e(@threads, :edges, []) != []}
      <ul id="message_threads" class="flex divide-hair divide-divider flex-col">
        {#for %{activity: activity} <- filter_threads(e(@threads, :edges, []), @search_term)}
          {#case {thread_id(activity),
             permalink(
               e(activity, :replied, nil),
               e(activity, :object, nil) || e(activity, :object_id, nil) || activity,
               @filter_tab
             ), unread_for?(activity, @__context__)}}
            {#match {tid, thread_permalink, unread?}}
              <li
                id={"thread-#{tid}"}
                data-id={"thread_#{tid}"}
                data-href={thread_permalink}
                phx-hook="Bonfire.UI.Common.PreviewContentLive#PreviewActivity"
                class={[
                  "bg-base-100 cursor-pointer previewable_activity",
                  "message-active": @thread_id == tid
                ]}
              >
                <Bonfire.UI.Common.OpenPreviewLive
                  href={thread_permalink}
                  parent_id={"thread-#{tid}"}
                  open_btn_text=""
                  title_text={e(activity, :replied, :thread, :named, :name, nil) ||
                    e(activity, :thread_participants_names, nil) ||
                    l("Conversation")}
                  modal_assigns={Bonfire.UI.Social.ActivityLive.thread_preview_modal_assigns(
                    tid,
                    id(e(activity, :object, nil)),
                    id(activity),
                    activity,
                    e(activity, :object, nil),
                    e(activity, :replied, :reply_to, nil)
                  ) ++
                    [
                      current_url: thread_permalink,
                      sort_by: :latest_reply,
                      sort_order: :asc,
                      show_reply_input: true,
                      thread_mode: :flat
                    ]}
                  root_assigns={[
                    page_title: l("Conversation")
                  ]}
                />
                <!-- hide_thread_stats: true, -->

                <div
                  class="flex items-center gap-3 px-4 py-3"
                  phx-click={if unread?, do: "Bonfire.Messages:mark_thread_seen"}
                  phx-value-activity_id={id(activity)}
                >
                  {!-- AVATAR: 1-on-1 vs Group Thread vs Fallback --}
                  {#case e(activity, :thread_participant_count, 0)}
                    {#match 1}
                      {!-- 1-on-1: other person's avatar --}
                      <div class="flex-none">
                        <Bonfire.UI.Common.AvatarLive
                          parent_id={deterministic_dom_id(__MODULE__, tid, "msg_av", @parent_id)}
                          src={Media.avatar_url(e(activity, :thread_other_participant, nil))}
                          user_id={id(e(activity, :thread_other_participant, nil))}
                          title={e(activity, :thread_other_participant, :profile, :name, nil)}
                          wrapper_class="border-0 avatar !flex size-12"
                          class="size-12 rounded-full object-cover"
                          is_remote={!check_is_local?(e(activity, :thread_other_participant, nil), preload_if_needed: false)}
                        />
                      </div>
                    {#match count when count > 1}
                      <!-- Group (2+ participants): colored circle with group icon -->
                      <div class={"flex-none size-12 rounded-full flex items-center justify-center #{group_avatar_color(e(activity, :replied, :thread_id, nil))}"}>
                        {!-- <span class="indicator-item badge badge-secondary">{count}</span> --}
                        <#Icon iconify="ph:users-duotone" class="size-6 text-white" />
                      </div>
                    {#match _}
                      <!-- Fallback: last sender avatar -->
                      <div class="flex-none">
                        <Bonfire.UI.Common.AvatarLive
                          parent_id={deterministic_dom_id(__MODULE__, tid, "msg_av_sub", @parent_id)}
                          src={Media.avatar_url(e(activity, :subject, nil))}
                          user_id={e(activity, :subject_id, nil)}
                          wrapper_class="border-0 avatar !flex size-12"
                          class="size-12 rounded-full object-cover"
                          is_remote={!check_is_local?(e(activity, :subject, nil), preload_if_needed: false)}
                        />
                      </div>
                  {/case}

                  {!-- TEXT CONTENT --}
                  <div class="flex-1 min-w-0">
                    {!-- Name + timestamp row --}
                    <div class="flex items-baseline justify-between gap-2">
                      <span
                        data-id="thread_participants"
                        class={[
                          "text-base truncate flex-1",
                          "font-bold text-base-content": unread?,
                          "font-medium text-base-content": !unread?
                        ]}
                      >
                        {#case e(activity, :replied, :thread, :named, :name, nil)}
                          {#match nil}
                            {e(activity, :thread_participants_names, nil) ||
                              e(activity, :subject, :profile, :name, nil) ||
                              e(activity, :subject, :character, :username, nil) ||
                              l("Someone")}{#if e(activity, :thread_participant_count, 0) > 5}
                              +{e(
                                activity,
                                :thread_participant_count,
                                0
                              ) - 5}{/if}
                          {#match thread_name}
                            {thread_name}
                        {/case}
                      </span>
                      <time
                        datetime={DatesTimes.date_from_pointer(activity)}
                        class="text-xs text-muted flex-none whitespace-nowrap"
                      >{DatesTimes.date_from_now(activity)}</time>
                    </div>

                    {!-- Message preview + unread dot --}
                    <div class="flex items-center gap-2">
                      <p class="text-sm truncate flex-1 opacity-80">
                        {!-- In group chats, show sender name prefix --}
                        {#if e(activity, :thread_participant_count, 0) > 1}
                          <span class="font-medium text-muted">
                            {if e(activity, :subject_id, nil) == current_user_id(@__context__),
                              do: l("Me"),
                              else: e(activity, :subject, :profile, :name, nil)}:
                          </span>{" "}
                        {#elseif e(activity, :subject_id, nil) == current_user_id(@__context__)}
                          <span class="font-medium text-muted">{l("Me")}:</span>{" "}
                        {/if}
                        {Text.text_only(
                          e(activity, :object, :post_content, :name, nil) ||
                            e(activity, :object, :post_content, :summary, nil) ||
                            e(activity, :object, :post_content, :html_body, nil)
                        )}
                      </p>
                      {!-- Unread dot --}
                      <span
                        :if={unread?}
                        data-id="unread_dot"
                        data-thread-id={tid}
                        class="flex-none size-2.5 rounded-full bg-primary"
                      />
                    </div>
                  </div>
                </div>
              </li>
          {/case}
        {/for}
      </ul>

      {#if @search_term && filter_threads(e(@threads, :edges, []), @search_term) == []}
        <div class="flex flex-col items-center gap-2 py-8 text-center">
          <p class="text-sm text-muted">{l("No conversations match your search")}</p>
        </div>
      {/if}

      <Bonfire.UI.Common.LoadMoreLive
        live_handler={Bonfire.Messages}
        page_info={e(@threads, :page_info, nil)}
        context={@context}
        infinite_scroll
        target="#message_threads"
      />
    {#else}
      <div class="flex flex-col items-center gap-3 my-12 px-6 text-center">
        <div class="size-16 rounded-full bg-fill flex items-center justify-center mb-2">
          <#Icon iconify="ph:tray-duotone" class="size-8 text-subtle" />
        </div>
        <h3 class="type-heading">{l("Welcome to your inbox")}</h3>
        <p class="text-sm text-muted max-w-[260px]">
          {l("Drop a line, write a direct message with other users in the fediverse.")}
        </p>
        <button
          phx-click="Bonfire.Messages:toggle_contact_picker"
          class="gap-2 mt-3 btn btn-sm btn-soft btn-primary"
        >
          <#Icon iconify="ph:tray-duotone" class="size-4" />
          {l("Send a message")}...
        </button>
      </div>
    {/if}
  {/if}
</div>
